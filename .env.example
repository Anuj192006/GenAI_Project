# ─── ChurnPredictor AI — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values before running the app.
# Run: cp .env.example .env

# ─── Groq LLM (REQUIRED for LLM-powered analysis) ─────────────────────────────
# Free API key: https://console.groq.com → "Create API Key"
# Model used: llama-3.1-8b-instant (free tier, ~500 req/day)
GROQ_API_KEY=your_groq_api_key_here


# ─── Optional: Alternative LLM Providers ──────────────────────────────────────
# Leave blank unless switching providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── RAG Configuration ────────────────────────────────────────────────────────
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TOP_K=5

# ─── App Configuration ────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
